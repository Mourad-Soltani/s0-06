# Copy to .env and fill in. NEVER commit .env. Compose reads it for the ${...} values in docker-compose.yml.
# Passwords travel inside URLs: use 20+ characters of letters, digits and . _ ~ - only, e.g. `openssl rand -hex 24`.

# ---- Database -------------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
SAP_WORKER_PASSWORD=
SAP_REVIEW_PASSWORD=
SAP_WEBHOOK_PASSWORD=

# ---- Email (Postmark) -----------------------------------------------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Leave false until the first live check (cutover C3): see ADR-27.
POSTMARK_LOOKUP=false
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=
EMAIL_UNSUBSCRIBE_URL=

# ---- Marketplaces: set the ones you sell on -------------------------------------------------------------------------
GUMROAD_ACCESS_TOKEN=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
PAYHIP_API_KEY=
# Payhip cannot list products: a JSON list of {"key","name","price_minor"} under ./config, e.g. /config/payhip.json
PAYHIP_CATALOG_FILE=
# true = choose between marketplaces for a product sold on several (ADR-26)
ROUTING_ENABLED=false

# ---- What the Guard and the qualifier need --------------------------------------------------------------------------
# Hosts a checkout link may point to, comma separated (every marketplace you use).
ALLOWED_LINK_HOSTS=
# Product ids whose buyers are your ideal customers, comma separated.
ICP_PRODUCT_IDS=
MAX_DISCOUNT_PCT=0

# ---- Language model: leave all blank to write every draft from the standard template ------------------------------
# Give a provider (openai or anthropic), its key, the model name and ITS PRICES. Prices are micro-USD per million tokens (1 USD = 1000000):
# take them from the provider's price page for the model you chose; nothing is built in and 0 is refused. The monthly ceiling is
# core.cost_config (default 300 USD); a call that would pass it is not made and the draft falls back to the template.
# OPENAI_API_KEY (or ANTHROPIC_API_KEY) alone is enough to name the provider; LLM_API_KEY is the generic alternative.
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_PRICE_MICRO_PER_MTOK=
LLM_OUTPUT_PRICE_MICRO_PER_MTOK=
LLM_MAX_RETRIES=2

# ---- Worker ---------------------------------------------------------------------------------------------------------
WORKER_ID=worker-1
POLL_INTERVAL_SECONDS=1
CLOSER_SWEEP_SECONDS=60
# How often the Scout looks for new sales (Gumroad is polled; Lemon Squeezy and Payhip arrive by webhook). 0 turns it off.
SCOUT_POLL_SECONDS=30
